# Copy this file to .env.local and fill in your real Firebase project values.
# Find these in Firebase Console > Project Settings > General > Your apps > SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Used to build public QR code URLs and the magic-link redirect.
# Only needed for local development — on Vercel this is auto-derived from
# Vercel's own VERCEL_URL system variable at build time (see next.config.js
# and the README's "Deploy to Vercel" section), so leave it unset in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
