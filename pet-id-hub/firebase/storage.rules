rules_version = '2';

// =========================================================
// Pet ID & Community Hub — Firebase Storage Rules
// Deploy: Firebase Console > Storage > Rules (paste this in),
// or `firebase deploy --only storage` with the Firebase CLI.
// =========================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Pet photos: publicly readable (needed for the public QR page and
    // community feed), but only the owning user can upload into their
    // own folder — enforced by requiring the uid in the path.
    match /pet-photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Community post photos: publicly readable, only signed-in users
    // can upload into their own folder.
    match /community-photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
